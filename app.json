{
  "expo": {
    "name": "Studiemaat",
    "slug": "studiemaat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "studiemaat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "nl.studiemaat.app",
      "associatedDomains": [
        "applinks:studiemaat.nl",
        "applinks:www.studiemaat.nl"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationCategoryType": "public.app-category.education",
        "NSCameraUsageDescription": "Studiemaat gebruikt je camera om foto's te maken van je lesstof.",
        "NSPhotoLibraryUsageDescription": "Studiemaat gebruikt je foto's om lesstof toe te voegen.",
        "NSMicrophoneUsageDescription": "Studiemaat luistert als je een antwoord hardop zegt.",
        "NSSpeechRecognitionUsageDescription": "Studiemaat zet je gesproken antwoord om in tekst."
      }
    },
    "android": {
      "package": "nl.studiemaat.app",
      "adaptiveIcon": {
        "backgroundColor": "#18775B",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "studiemaat.nl"
            },
            {
              "scheme": "https",
              "host": "www.studiemaat.nl"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F4EE",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0E1614"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Studiemaat gebruikt je foto's om lesstof toe te voegen.",
          "cameraPermission": "Studiemaat gebruikt je camera om foto's te maken van je lesstof."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Studiemaat luistert als je een antwoord hardop zegt.",
          "speechRecognitionPermission": "Studiemaat zet je gesproken antwoord om in tekst."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#25916F",
          "icon": "./assets/images/notification-icon.png"
        }
      ],
      "@sentry/react-native",
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "decc02c6-9399-4684-bdde-529bbe739cb2"
      }
    },
    "owner": "mediasolutions",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/decc02c6-9399-4684-bdde-529bbe739cb2"
    }
  }
}
