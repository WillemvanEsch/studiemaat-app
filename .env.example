# Kopieer naar .env. Alleen EXPO_PUBLIC_* komt in de app; zet hier nooit geheimen.
# Zet dezelfde waarden ook in EAS (eas env:create), want eas build leest .env niet.

# Koppeling met de website. Lokaal testen: http://<ip-van-je-computer>:3000/api/v1
EXPO_PUBLIC_API_BASE_URL=https://www.studiemaat.nl/api/v1

# Sentry (crashmeldingen). Leeg = geen Sentry.
EXPO_PUBLIC_SENTRY_DSN=
